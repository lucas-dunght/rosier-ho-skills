# ==============================================================================
# RS-OS HO Edition (v6.7.0-ho.2) · Cấu Hình Token & Biến Môi Trường Khối Văn Phòng HO
# Cảnh báo Bảo mật:
#   - Tệp .env thực tế trong <workspace>/.agent/.env được khóa quyền đọc riêng (chmod 600).
#   - Chỉ sử dụng Token cấp Phòng ban HO (Read-Only & Draft Staging).
#   - Hệ thống tự động chặn mọi Token đặc quyền CEO/DB-Admin (CEO_MASTER_, DB_ADMIN_)
#     cùng mọi cờ cho phép ghi đè Database gốc (ROSIER_ALLOW_DB_MUTATION=true).
# ==============================================================================

# 1. Định danh Vai trò & Gói Kỹ năng Phòng ban Khối HO
# Giá trị hợp lệ: ho_ops_supply | ho_fin_accounting | ho_hr_legal | ho_academy_rnd | ho_mkt_media | ho_cskh_omni | internal_staff | store_owner_company | store_owner_hkd | store_manager
ROSIER_HO_ROLE="ho_ops_supply"
ROSIER_HO_PROFILE="ho-all-126"

# 2. Chốt chặn An toàn Thực thi & Database (BẮT BUỘC GIỮ NGUYÊN)
ROSIER_EDITION="HO_STAFF_SAFE_EDITION"
ROSIER_EXECUTION_MODE="HO_SAFE_READ_AND_DRAFT"
ROSIER_ALLOW_DB_MUTATION="false"

# 3. Kho Tri Thức 2-Hub (ROSIER_BUSINESS & ROSIER_STORE_HUB)
ROSIER_BUSINESS_HUB_ID="15e4ffbe44fc8390be0601a8074420d9"
ROSIER_STORE_HUB_ID="4e14ffbe44fc8324b4ef01ba406a8a5e"
ROSIER_NOTION_HO_TOKEN="ROS_HO_NOTION_READ_DRAFT_PLACEHOLDER"

# 4. Token Kết nối Các Phân Hệ Nghiệp Vụ Khối HO (Read-Only / Draft)
ROSIER_LMS_HO_TOKEN="ROS_HO_LMS_READ_DRAFT_PLACEHOLDER"
ROSIER_POS_READONLY_TOKEN="ROS_HO_POS_READONLY_PLACEHOLDER"
ROSIER_SUPPLY_ERP_READONLY_TOKEN="ROS_HO_SUPPLY_READONLY_PLACEHOLDER"
ROSIER_WORK_EXEC_HO_TOKEN="ROS_HO_WORK_EXEC_DRAFT_PLACEHOLDER"

# 5. Điểm bán mặc định khi tra cứu thử nghiệm (Không được dùng mã đã đóng cửa: 115953, 106192)
ROSIER_DEFAULT_STORE_CODE="38197"

# 6. Cấu hình Tự động Cập nhật Định kỳ 24h
ROSIER_AUTO_UPDATE_ENABLED="true"
ROSIER_AUTO_UPDATE_INTERVAL_HOURS="24"
